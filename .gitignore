# Godot 4+ editor/cache data
.godot/

# Android export template generated by Godot.
# Keep native plugin AARs under addons/ versioned.
/android/

# Godot/editor temporary files
*.tmp
*.temp
*.bak
*.backup
*.autosave

# Local backups/archives
*.rar
*.zip
*.7z

# Exported builds
/build/
/builds/
/exports/
/dist/
*.apk
*.aab
*.exe
*.pck
*.zip.tmp

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini

# Local secrets/signing material
*.keystore
*.jks
*.p12
*.mobileprovision
*.env

# Keep these tracked when generated by Godot:
# - *.import files store import settings for assets.
# - *.uid files store stable resource IDs in newer Godot versions.
